<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Googleドライブへの保存方式"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/radioApi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="API方式（Googleでログイン）" />

            <RadioButton
                android:id="@+id/radioGas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GAS方式（中継スクリプト）" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/groupApi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btnGoogleLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Googleでログイン" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupGas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GASのウェブアプリURL" />

        <EditText
            android:id="@+id/editGasUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://script.google.com/macros/s/.../exec"
            android:inputType="textUri" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="合言葉（GASの SECRET と同じ文字列）" />

        <EditText
            android:id="@+id/editGasKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textVisiblePassword" />

        <Button
            android:id="@+id/btnTestGas"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GAS連携をテスト" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchLocal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="スマホ本体（Download/FANZA）にも保存する" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchWifi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wi-Fi接続中のみ処理する" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="購入済みページを開いたら未保存作品を自動で保存" />

        <Button
            android:id="@+id/btnClearHistory"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存済み履歴をリセット" />

        <Button
            android:id="@+id/btnDumpPage"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ページ情報を保存（不具合報告用）" />

        <TextView
            android:id="@+id/textInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
